# CONFIGURACIÓN COMPARTIDA
SERVICE_NAME=ms-comparendos
PORT=8005

# 1. LOCAL NATIVE (Host PC)
# COMPARENDOS_DB_HOST=localhost
# COMPARENDOS_DB_PORT=5436
# COMPARENDOS_DB_NAME=comparendos_db
# COMPARENDOS_DB_USER=admin
# COMPARENDOS_DB_PASSWORD=admin123
# JWT_SECRET=secret123
# PERSONAS_SERVICE_URL=http://localhost:8002/api
# AUTOMOTORES_SERVICE_URL=http://localhost:8003/api
# INFRACCIONES_SERVICE_URL=http://localhost:8004/api

# 2. PROVISIONAMIENTO NATIVO (Vagrant)
# COMPARENDOS_DB_HOST=localhost
# COMPARENDOS_DB_PORT=5436
# COMPARENDOS_DB_NAME=comparendos_db
# COMPARENDOS_DB_USER=admin
# COMPARENDOS_DB_PASSWORD=admin123
# JWT_SECRET=secret123
# PERSONAS_SERVICE_URL=http://localhost:8002/api
# AUTOMOTORES_SERVICE_URL=http://localhost:8003/api
# INFRACCIONES_SERVICE_URL=http://localhost:8004/api

# 3. DOCKER (Local)
# COMPARENDOS_DB_HOST=db-comparendos
# COMPARENDOS_DB_PORT=5432
# COMPARENDOS_DB_NAME=comparendos_db
# COMPARENDOS_DB_USER=admin
# COMPARENDOS_DB_PASSWORD=admin123
# JWT_SECRET=secret123
# PERSONAS_SERVICE_URL=http://ms-personas:8002/api
# AUTOMOTORES_SERVICE_URL=http://ms-automotores:8003/api
# INFRACCIONES_SERVICE_URL=http://ms-infracciones:8004/api

# 4. SWARM (Producción)
# Nota: COMPARENDOS_DB_PASSWORD y JWT_SECRET se manejan vía Docker Secrets
# COMPARENDOS_DB_HOST=db-comparendos
# COMPARENDOS_DB_PORT=5432
# COMPARENDOS_DB_NAME=comparendos_db
# COMPARENDOS_DB_USER=admin
# PERSONAS_SERVICE_URL=http://ms-personas:8002/api
# AUTOMOTORES_SERVICE_URL=http://ms-automotores:8003/api
# INFRACCIONES_SERVICE_URL=http://ms-infracciones:8004/api
