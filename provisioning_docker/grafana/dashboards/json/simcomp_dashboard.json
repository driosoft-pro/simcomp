      "id": 1,
      "panels": [],
      "title": "KPIs de Salud Críticos",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "OFF" }, "1": { "color": "green", "index": 1, "text": "ON" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 101,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [ { "expr": "up{job=\"haproxy\"}", "refId": "A" } ],
      "title": "Status Balancer",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 102,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "textMode": "value" },
      "targets": [ 
        { "expr": "avg(haproxy_frontend_http_response_time_average_seconds) * 1000 or vector(0)", "refId": "A" } 
      ],
      "title": "Latencia (Avg)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 104,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "textMode": "value" },
      "targets": [ { "expr": "100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A" } ],
      "title": "CPU Maquina",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 105,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "textMode": "value" },
      "targets": [ { "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "refId": "A" } ],
      "title": "RAM Usada",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 103,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "textMode": "value" },
      "targets": [ { "expr": "sum(rate(haproxy_frontend_http_requests_total[5m]))", "refId": "A" } ],
      "title": "Requests/sec",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 106,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value" },
      "targets": [ { "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\"} * 100) / node_filesystem_size_bytes{mountpoint=\"/\"})", "refId": "A" } ],
      "title": "Disco Usado",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 2,
      "panels": [],
      "title": "Rendimiento Detallado por Microservicio",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 201,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(haproxy_backend_http_requests_total[5m])", "legendFormat": "{{proxy}}", "refId": "A" }
      ],
      "title": "Tráfico por Backend",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 203,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "haproxy_backend_response_time_average_seconds * 1000", "legendFormat": "{{proxy}}", "refId": "A" }
      ],
      "title": "Latencia por Microservicio",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 3,
      "panels": [],
      "title": "Uptime y Salud de Microservicios",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "id": 301,
      "options": { "showLegend": true },
      "targets": [
        { "expr": "up{job=~\"ms-.*\"}", "legendFormat": "{{job}}", "refId": "A" }
      ],
      "title": "Línea de Tiempo de Salud",
      "type": "state-timeline"
    }
  ],
