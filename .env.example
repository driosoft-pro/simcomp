# SIMCOMP - Frontend Environment Configuration
# ==========================================

# Use this file as a template for your .env files.
# Choose the configuration that matches your deployment method.

# 1. LOCAL NATIVE (Host PC)
# Running everything directly on your machine (microservices + haproxy).
# VITE_API_BASE_URL=http://localhost:8080/api

# 2. PROVISIONAMIENTO NATIVO (Vagrant)
# Services running in standard VMs. Point to the gateway VM (srv-web).
# VITE_API_BASE_URL=http://192.168.100.4/api

# 3. DOCKER (Docker Hub Images)
# Running docker-compose.local.yml. Points to HAProxy container port.
# VITE_API_BASE_URL=http://localhost:8080/api

# 4. PROVISIONAMIENTO VAGRANT + DOCKER SWARM
# Distributed cluster in Vagrant. Access via manager or simcomp.co domain.
# VITE_API_BASE_URL=http://simcomp.co/api

# Configuración para desarrollo local nativo (punteros directos a microservicios)
#VITE_AUTH_API=http://localhost:8001/api
#VITE_PERSONAS_API=http://localhost:8002/api
#VITE_AUTOMOTORES_API=http://localhost:8003/api
#VITE_INFRACCIONES_API=http://localhost:8004/api
#VITE_COMPARENDOS_API=http://localhost:8005/api
#VITE_REPORTES_API=http://localhost:8006/api

# DEFAULT / PRODUCTION
# Relative path (assumes frontend and api are behind the same domain/proxy).
VITE_API_BASE_URL=/api